---
import { getCollection, getEntry } from 'astro:content';
import Syarat from './Syarat.astro';
import { kontakLinks } from '../lib/kontak';
// FR-9 (keputusan 2026-11-17): alur ringkas, tanpa durasi/biaya; detail biaya dan jadwal ditangani CS.
const tahap = (await getCollection('alur')).map((e) => e.data).sort((a, b) => a.nomor - b.nomor);
const site = (await getEntry('site', 'site'))!.data;
const { wa, mail } = kontakLinks(site, 'Halo, saya ingin menanyakan biaya dan jadwal penerbitan naskah.');
---
<section id="alur" aria-labelledby="alur-title">
  <p class="lbl">Alur Terbit</p>
  <h2 id="alur-title">Dari naskah sampai terbit, kami temani</h2>
  <p class="alur-lead">Prosesnya jelas dalam {tahap.length} langkah. Anda fokus pada riset, kami mengawal sisanya.</p>
  <ol class="alur-list">
    {tahap.map((t) => (
      <li class="alur-item">
        <span class="alur-no lbl" aria-hidden="true">{String(t.nomor).padStart(2, '0')}</span>
        <h3>{t.judul}</h3>
        <p class="alur-desc">{t.deskripsi}</p>
      </li>
    ))}
  </ol>
  <div class="alur-cs">
    <p class="alur-cs-teks">Ingin tahu biaya dan jadwal untuk naskah Anda? Tim CS kami menjelaskannya langsung.</p>
    <div class="alur-cs-btn">
      {wa && <a class="btn lbl" href={wa} rel="noopener noreferrer">Tanya CS di WhatsApp</a>}
      {mail && <a class="btn btn-alt lbl" href={mail}>Atau lewat email</a>}
    </div>
  </div>
  <Syarat />
</section>
<style>
  section { padding: 48px 0; border-top: 1px solid var(--rule); display: grid; gap: var(--space-2); }
  p { margin: 0; }
  h2 { margin: 0; font-weight: 400; font-size: clamp(28px, 4.4vw, 56px); line-height: 1.05; letter-spacing: -0.02em; }
  .alur-lead { max-width: 60ch; font-size: 19px; line-height: 1.5; }
  .alur-list { list-style: none; margin: var(--space-1) 0 0; padding: 0; display: grid; gap: var(--space-3); }
  .alur-item { border-top: 1px solid var(--rule); padding-top: var(--space-2); display: grid; gap: var(--space-1); align-content: start; }
  .alur-item h3 { margin: 0; font-weight: 400; font-size: 26px; line-height: 1.15; }
  .alur-desc { max-width: 40ch; color: var(--muted); }
  .alur-cs { border: 1px solid var(--rule); padding: var(--space-3); display: grid; gap: var(--space-2); }
  .alur-cs-teks { font-size: 22px; line-height: 1.3; max-width: 36ch; }
  .alur-cs-btn { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-2); }
  .btn { display: inline-flex; align-items: center; min-height: 44px; padding: 0 20px; text-decoration: none; background: var(--cobalt); color: #fff; border: 1px solid var(--cobalt); transition: background-color 0.45s var(--ease), color 0.45s var(--ease); }
  .btn:hover { background: var(--ink); border-color: var(--ink); }
  .btn-alt { background: transparent; color: var(--cobalt); }
  .btn-alt:hover { background: var(--cobalt); border-color: var(--cobalt); color: #fff; }
  @media (min-width: 768px) {
    section { padding: 96px 0; }
    .alur-list { grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: var(--space-3); }
    .alur-cs { grid-template-columns: 1fr auto; align-items: center; }
  }
</style>
