---
import { getCollection } from 'astro:content';
import Gambar from './Gambar.astro';
// FR-25: strip logo mitra/institusi. alt wajib lewat skema zod (mitra.json). Kosong → tidak dirender.
// ponytail: kotak logo tetap 160x64 (fit contain via astro:assets, t31); skema belum menyimpan dimensi asli.
const daftar = (await getCollection('mitra')).map((e) => e.data);
---
{daftar.length > 0 && (
<ul class="mitra" aria-label="Mitra dan institusi">
  {daftar.map((m) => (
    <li>
      {m.url
        ? <a href={m.url} target="_blank" rel="noopener noreferrer"><Gambar src={m.logo} alt={m.alt} width={160} height={64} fit="contain" /></a>
        : <Gambar src={m.logo} alt={m.alt} width={160} height={64} fit="contain" />}
    </li>
  ))}
</ul>
)}
<style>
  .mitra { list-style: none; margin: var(--space-2) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-3); align-items: center; }
  .mitra li { display: flex; }
  .mitra a { display: inline-flex; min-height: 44px; align-items: center; }
  .mitra img { width: 160px; height: 64px; object-fit: contain; }
</style>
