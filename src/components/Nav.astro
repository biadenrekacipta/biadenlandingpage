---
import type { Section } from '../lib/sections';
interface Props {
  nama: string;
  sections: Section[];
  jumlahJurnal?: number;
}
const { nama, sections, jumlahJurnal = 0 } = Astro.props;
---
<header class="nav">
  <div class="wrap nav-in">
    <nav aria-label="Navigasi utama" class="nav-kiri">
      {/* ponytail: dua daftar (inline di desktop, <details> di mobile) tanpa JS. Satu <details> yang dipaksa terbuka di desktop butuh ::details-content yang belum merata di browser. */}
      <ul class="nav-desktop">
        {sections.map((s) => <li><a class="nav-link lbl" href={`#${s.id}`}>{s.label}</a></li>)}
      </ul>
      <details class="nav-mobile">
        <summary class="box lbl">Menu</summary>
        <ul class="nav-panel">
          {sections.map((s) => <li><a class="nav-link lbl" href={`#${s.id}`}>{s.label}</a></li>)}
        </ul>
      </details>
    </nav>
    <a class="nav-brand" href="/" aria-label={`${nama}, beranda`}>
      <span class="nav-logo">{nama}</span>
      <span class="nav-sub">Penerbit jurnal ilmiah</span>
    </a>
    <p class="nav-fakta lbl">{jumlahJurnal > 0 ? `${jumlahJurnal} jurnal · terbit Juni & Desember` : 'Terbit Juni & Desember'}</p>
  </div>
</header>
<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 30;
    height: var(--header-h);
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
  }
  .nav-in { height: 100%; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: var(--space-2); }
  .nav-kiri { justify-self: start; }
  .nav-brand { display: grid; justify-items: center; gap: 5px; text-decoration: none; color: var(--cobalt); min-height: 44px; align-content: center; }
  .nav-logo { font-size: 17px; letter-spacing: 0.04em; line-height: 1; }
  .nav-sub { font-family: var(--sans); font-weight: 600; font-size: 9px; letter-spacing: 0.34em; padding-left: 0.34em; text-transform: uppercase; line-height: 1; }
  .nav-fakta { display: none; margin: 0; justify-self: end; }
  ul { list-style: none; margin: 0; padding: 0; }
  .nav-desktop { display: none; gap: var(--space-1); }
  .nav-link { display: inline-flex; align-items: center; min-height: 44px; padding: 0 12px; text-decoration: none; }
  .nav-link:hover { color: var(--cobalt); }
  .nav-mobile { position: static; }
  summary { cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .nav-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: var(--header-h);
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
    padding: var(--space-1) var(--gutter) var(--space-2);
  }
  .nav-panel .nav-link { width: 100%; }
  @media (min-width: 768px) {
    .nav-desktop { display: flex; }
    .nav-mobile { display: none; }
    .nav-logo { font-size: 22px; }
  }
  @media (min-width: 1100px) {
    .nav-fakta { display: block; }
  }
</style>
