---
import { getEntry } from 'astro:content';
import { kontakLinks } from '../lib/kontak';
const site = (await getEntry('site', 'site'))!.data;
const { wa } = kontakLinks(site, 'Halo, saya tertarik menerbitkan naskah di jurnal Biadenrekacipta.');
---
<section class="tutup" aria-labelledby="tutup-title">
  <svg class="tutup-art" viewBox="0 0 300 300" aria-hidden="true" focusable="false">
    <circle cx="170" cy="130" r="110" class="a" />
    <circle cx="120" cy="170" r="90" class="b" />
    <rect x="150" y="60" width="90" height="190" class="c" />
  </svg>
  <div class="tutup-isi">
    <p class="lbl" data-rv>Mulai dari satu langkah</p>
    <h2 id="tutup-title" data-rv>Siap menerbitkan riset Anda?</h2>
    <p class="tutup-p" data-rv>Kirim naskah lewat formulir di bawah, atau ngobrol dulu dengan tim kami.</p>
    <div class="tutup-btn" data-rv>
      <a class="btn lbl" href="#ajukan">Ajukan naskah</a>
      {wa && <a class="btn btn-o lbl" href={wa} rel="noopener noreferrer">Tanya CS</a>}
    </div>
  </div>
</section>
<style>
  .tutup { position: relative; overflow: hidden; margin-top: var(--space-4); background: var(--cobalt); color: var(--sheet); padding: var(--space-4) var(--space-3); display: grid; }
  .tutup-isi { position: relative; display: grid; gap: var(--space-2); max-width: 36rem; }
  h2 { margin: 0; font-weight: 400; font-size: clamp(36px, 6vw, 80px); line-height: 1; letter-spacing: -0.025em; }
  p { margin: 0; }
  .tutup-p { font-size: 19px; line-height: 1.5; }
  .tutup-btn { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-2); margin-top: var(--space-1); }
  .btn { display: inline-flex; align-items: center; min-height: 44px; padding: 0 20px; text-decoration: none; background: var(--sheet); color: var(--cobalt); border: 1px solid var(--sheet); transition: background-color 0.45s var(--ease), color 0.45s var(--ease); }
  .btn:hover { background: var(--ink); border-color: var(--ink); color: var(--sheet); }
  .btn-o { background: transparent; color: var(--sheet); }
  .btn-o:hover { background: var(--sheet); border-color: var(--sheet); color: var(--cobalt); }
  :focus-visible { outline-color: var(--sheet); }
  .tutup-art { position: absolute; right: -70px; bottom: -110px; width: 240px; height: 240px; }
  .a { fill: var(--vermilion, #c8391f); mix-blend-mode: multiply; }
  .b { fill: var(--ink); mix-blend-mode: multiply; opacity: 0.55; }
  .c { fill: var(--sheet); opacity: 0.12; }
  @media (min-width: 768px) {
    .tutup { padding: var(--space-5) 8%; }
    .tutup-art { right: 2%; bottom: -40px; width: 520px; height: 520px; }
  }
</style>
