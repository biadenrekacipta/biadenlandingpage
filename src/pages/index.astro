---
import { getEntry, getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Profil from '../components/Profil.astro';
import Alur from '../components/Alur.astro';
import Katalog from '../components/Katalog.astro';
import Testimoni from '../components/Testimoni.astro';
import Faq from '../components/Faq.astro';
import FormAjukan from '../components/FormAjukan.astro';
import Nav from '../components/Nav.astro';
import JsonLd from '../components/JsonLd.astro';
import { sectionTampil } from '../lib/sections';
import { katalogBuku, katalogJurnal, testimoniTampil } from '../lib/visible';
// Memaksa semua koleksi divalidasi saat build (t3).
await Promise.all(
  ['legalitas', 'alur', 'syarat', 'buku', 'jurnal', 'testimoni', 'mitra', 'faq'].map((c) =>
    getCollection(c as 'faq'),
  ),
);
const site = (await getEntry('site', 'site'))!.data;
// Katalog: anchor #katalog hanya ada bila ada item tampil (BR-6, BUG-4).
const adaKatalog =
  katalogBuku((await getCollection('buku')).map((e) => e.data)).length +
    katalogJurnal((await getCollection('jurnal')).map((e) => e.data)).length >
  0;
// Section testimoni tampil bila ada testimoni berizin atau logo mitra (FR-26).
const adaTestimoni =
  testimoniTampil((await getCollection('testimoni')).map((e) => e.data)).length > 0 ||
  (await getCollection('mitra')).length > 0;
// Daftar section = sumber tunggal untuk nav dan markup (t10). Section lain didaftarkan saat komponennya dibuat.
const adaFaq = (await getCollection('faq')).length > 0;
const ada = sectionTampil({ profil: true, alur: true, katalog: adaKatalog, testimoni: adaTestimoni, faq: adaFaq, ajukan: true });
const tampil = (id: string) => ada.some((s) => s.id === id);
// ponytail: kerangka section; isi diganti komponen di t9-t25. Judul di bawah hanya struktur, bukan klaim.
// FR-32, SEO-5, GEO-5: Organization + WebSite dari site.json (sumber yang sama dengan hero, profil, footer). Tanpa BreadcrumbList di beranda.
const origin = new URL('/', Astro.site).href;
const orgId = `${origin}#organization`;
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      name: site.nama,
      url: origin,
      description: site.ringkasan,
      email: site.email,
      address: site.lokasi,
      ...(site.sameAs.length ? { sameAs: site.sameAs } : {}),
    },
    { '@type': 'WebSite', '@id': `${origin}#website`, url: origin, name: site.nama, inLanguage: 'id', publisher: { '@id': orgId } },
  ],
};
const title = `${site.nama}: Penerbit Buku dan Jurnal Akademik`;
const description = `Penerbit buku dan jurnal akademik ${site.nama}. Lihat profil, alur terbit, dan ajukan naskah Anda.`;
---
<Base title={title} description={description}>
  <Nav slot="header" nama={site.nama} sections={ada} />
  <JsonLd data={ld} />
  <div class="wrap">
    <Hero />
    {tampil('profil') && <Profil />}
    {tampil('alur') && <Alur />}
    {tampil('katalog') && <Katalog />}
    {tampil('testimoni') && <Testimoni />}
    {tampil('faq') && <Faq />}
    {tampil('ajukan') && <FormAjukan />}
  </div>
</Base>
